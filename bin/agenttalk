#!/usr/bin/env bash
# agenttalk — the command-line half of the AgentTalk Omarchy plugin.
#
# The panel (QML) is a view: it renders an event log and shells out to this
# script for everything that touches the disk or a process. Keeping the work
# here means the panel has no privileged logic, the awkward parts (process
# groups, JSON normalization, cwd resolution) are testable from a terminal, and
# an agent run keeps going when the panel closes or the shell reloads.
#
# One conversation per agent, stored as an append-only event log:
#
#   $STATE/agents/<agent>/meta.json     session id, workdir, pid, exit code,
#                                       and whether the workdir was chosen
#   $STATE/agents/<agent>/events.jsonl  one normalized event per line, forever
#   $STATE/agents/<agent>/panel.jsonl   the tail of that log, capped in bytes,
#                                       and the only one the panel ever reads
#   $STATE/agents/<agent>/stderr.log    raw stderr of the last run
#
# Two logs, on purpose. The panel wants a bounded amount of text, and a FileView
# reads the whole file it is given, so watching the complete log means a long
# conversation is read in full over and over to render a window that was never
# going to be that big. events.jsonl stays complete; panel.jsonl is the part
# the panel is allowed to have.
#
# Subcommands:
#   agents                        list agents as JSON
#   doctor                        report what this script can find (opencode, state)
#   init <agent...>               make sure session files exist
#   append <agent> <json>         append one event to an agent's log
#   run <agent> [options]         start a turn from a prompt on stdin (detached)
#   cd <agent> <dir|--window|--reset>  choose where that agent works
#   complete [dir-prefix] [stem]       list directories for Tab completion
#   clear <agent>                 forget the conversation
#   stop <agent>                  stop the running turn
#   cwd                           working directory for the focused window
#   state-dir                     print the state directory
#   bind [combo]                  bind a key to open the panel (default: SUPER + A)
#   unbind                        remove that keybinding again
#
# Environment:
#   AGENTTALK_OPENCODE_BIN  opencode binary to use (default: opencode)
#   AGENTTALK_STATE_DIR     state directory override
#   AGENTTALK_TIMEOUT       seconds before a run is killed (default: 3600)
#   HYPRLAND_CONFIG_DIR    Hyprland config directory (default: ~/.config/hypr)

set -uo pipefail

PLUGIN_ID="io.github.ramackersjp.agenttalk"
STATE_DIR="${AGENTTALK_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agenttalk}"
OPENCODE_BIN="${AGENTTALK_OPENCODE_BIN:-opencode}"
RUN_TIMEOUT="${AGENTTALK_TIMEOUT:-3600}"
HYPR_DIR="${HYPRLAND_CONFIG_DIR:-$HOME/.config/hypr}"

# How much of the log the panel is given, and how much is left when it is given
# too much. The cap is settled before each write rather than after, so the
# newest event is never the thing at risk, and a panel that loses the oldest half
# of a very long conversation is showing the part the user is actually reading.
PANEL_LOG_MAX="${AGENTTALK_PANEL_LOG_MAX:-262144}"
PANEL_LOG_KEEP="${AGENTTALK_PANEL_LOG_KEEP:-131072}"

# The note that stands in for an event too big to show has to fit inside the very
# budget it stands in for, so a budget smaller than the note is raised to it
# rather than producing a note that cannot be written.
PANEL_LOG_FLOOR=512
((PANEL_LOG_MAX > PANEL_LOG_FLOOR)) || PANEL_LOG_MAX="$PANEL_LOG_FLOOR"

# The largest single event, in bytes, that is read, kept or shown. A model that
# answers with one enormous line — a whole file in a tool result, a runaway
# repetition — is not a reason for a process that outlives the run to grow without
# limit, and a line has to be read before it can be judged, so the limit is on the
# read and not only on what happens to the event afterwards.
EVENT_MAX="${AGENTTALK_EVENT_MAX:-65536}"
# A limit this small would be smaller than the note that reports an event over
# it, and read -n 0 would never consume anything, so it is floored like the rest.
((EVENT_MAX > PANEL_LOG_FLOOR)) || EVENT_MAX="$PANEL_LOG_FLOOR"
# What read_bounded stops at. Same number as the event limit: a line this long is
# not an event any more, it is a line that has to be taken apart.
REPLY_MAX="$EVENT_MAX"

# How large the complete log may get, and how much is kept when it is over. That
# log is the whole conversation rather than the panel's window, so the numbers are
# generous; they are here so that "the whole conversation" is a bounded thing
# rather than a claim that gets slower and larger for as long as the disk lasts.
EVENTS_LOG_MAX="${AGENTTALK_EVENTS_LOG_MAX:-8388608}"
EVENTS_LOG_KEEP="${AGENTTALK_EVENTS_LOG_KEEP:-4194304}"
# A single event has to fit in the log that keeps it, and the notes that stand in
# for events have to fit in the log too, so both are floored rather than trusted.
((EVENTS_LOG_MAX > EVENT_MAX + PANEL_LOG_FLOOR)) || EVENTS_LOG_MAX=$((EVENT_MAX + PANEL_LOG_FLOOR + PANEL_LOG_FLOOR))
((EVENTS_LOG_KEEP > 0 && EVENTS_LOG_KEEP < EVENTS_LOG_MAX)) || EVENTS_LOG_KEEP=$((EVENTS_LOG_MAX / 2))

log() { printf 'agenttalk: %s\n' "$*" >&2; }

# A file the panel watches must never be readable half-written. `> file`
# truncates before the first byte of the new content lands, so anything reading
# in between gets an empty file, and jq on an empty file answers nothing at all
# — which is how a run's pinned workspace goes missing for no reason. Write
# beside it and rename: rename(2) within a directory is atomic, so a reader gets
# the old content or the new one and never neither.
write_atomic() {
  local path="$1" tmp
  tmp=$(mktemp "${path}.XXXXXX") || return 1
  if ! cat >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$path"
}

agent_dir() {
  local id="${1:-}"
  if [[ -z "$id" || "$id" == *"/"* || "$id" == "." || "$id" == ".." ]]; then
    log "invalid agent id: '$id'"
    return 1
  fi
  printf '%s/agents/%s' "$STATE_DIR" "$id"
}

# How many bytes a file holds, from the file itself. A caller that appends in a
# loop keeps the panel log's size from the count `append_event` hands back, but
# the length of one event is not knowable from a counter before that event has
# been written somewhere, so it is measured.
file_size() {
  local path="$1"
  [[ -f "$path" ]] || { printf '0'; return 0; }
  stat -c%s "$path" 2>/dev/null || printf '0'
}

# The length of a string in bytes rather than in characters. ${#} counts
# characters, so a cap measured with it is not a cap for a UTF-8 payload: it
# undercounts by up to four and lets the file past the number it claims to hold.
byte_length() {
  LC_ALL=C printf '%s' "$1" | wc -c | tr -d ' \n'
}

# Read one line from stdin into $REPLY; non-zero return means the input is done.
# Sets $reply_dropped when a line was too large to be one event and was not
# returned, so a caller that has something to say about it can.
#
# `read` on its own holds a whole line, and a model that answers with one
# enormous line — a file pasted into a tool result, a repetition that never
# stops — would then have that line held here, in a process that outlives the run
# and the model alike. `read -n` stops at the limit rather than at the newline, so
# a long line arrives in pieces of at most $REPLY_MAX and nothing unbounded is
# ever buffered. A piece that reaches the limit is an event over the limit by
# definition: it is dropped, the rest of that line with it, and the caller is told.
# The remainder of a JSON object is not JSON, so keeping it would only produce
# noise. Fewer characters than the limit means the newline was reached and the
# next line starts at the next read.
read_bounded() {
  local skip=0
  reply_dropped=0
  while IFS= read -r -n "$REPLY_MAX" REPLY || [[ -n "$REPLY" ]]; do
    if ((skip)); then
      ((${#REPLY} < REPLY_MAX)) && skip=0
      continue
    fi
    if ((${#REPLY} == REPLY_MAX)); then
      skip=1
      reply_dropped=1
      continue
    fi
    return 0
  done
  return 1
}

# The transcript's word for an event that is over the limit, whichever path it
# arrived by and whichever loop noticed. One sentence, not one per caller: the
# last two rounds of review were both about two copies of something disagreeing,
# and a message the user reads is no place to start that again. The size is named
# when the caller measured it and described as a lower bound when all the reader
# knows is that it stopped at the limit.
oversize_note() {
  local size
  if [[ -n "${1:-}" ]]; then size="an event of $1 bytes"; else size="an event of at least $EVENT_MAX bytes"; fi
  jq -nc --arg size "$size" --arg max "$EVENT_MAX" \
    '{t: "text", text: ("agenttalk: " + $size + " is over the " + $max + "-byte limit for one event, so it is not in this transcript; opencode still has it in full")}' \
    2>/dev/null || true
}

# What the panel shows in place of an event that is larger than the whole panel
# budget. The event stays in the complete log; this is a `text` event, so the
# panel needs no new shape to draw it. A blank transcript would look like a
# broken plugin, and a tool result cut off mid-way is a thing a user might act on
# as if it were the whole result.
panel_standin() {
  jq -nc --arg n "$1" \
    '{t: "text", text: ("agenttalk: " + $n + " bytes of output are too large to show in the panel; the whole event is in events.jsonl")}'
}

# Cut a log back to at most $2 bytes of its own tail. The caller says
# how much room the event it is about to write needs, which is the whole point:
# the newest event is written after the trim, so there is nothing here for a trim
# to throw away and no window to widen when the tail comes back empty.
#
# The first line of a byte-tail is half a line, and the panel already skips a line
# it cannot parse, so dropping it costs nothing and leaves whole lines behind.
trim_log() {
  local panel="$1" keep="$2" tmp
  ((keep > 0)) || keep=1
  tmp=$(mktemp "$panel.trim.XXXXXX") || return 1
  if ! tail -c "$keep" "$panel" | sed 1d >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$panel"
}

# Append one event to the complete log and to the panel's bounded view of it.
#
# Every cap here is settled before the write, never after it. The panel reads its
# log the moment it changes, into the shell process that outlives everything else,
# so a file that is briefly over its cap is a file that has already been read in
# full: appending first and trimming afterwards bounds a log only in the state
# nobody is looking at.
#
# The length is measured in bytes before anything is written, not counted in
# characters with ${#} and not derived from how much the file grew afterwards, so
# the decision does not depend on a write that may be the thing being bounded.
#
# Prints the size of the panel log afterwards, so a caller appending in a loop
# keeps a count without measuring the file itself on every event.
append_event() {
  local dir="$1" event="$2" bytes="${3:-}" panel="$dir/panel.jsonl"
  local events="$dir/events.jsonl" n keep

  n=$(( $(byte_length "$event") + 1 ))

  if ((n > EVENT_MAX)); then
    # Past what a single event is allowed to be, whoever sent it: a runaway
    # model, a whole file in a tool result, or a caller of `append` with a
    # megabyte on its argument list. The transcript says so rather than carrying
    # the payload, and opencode still holds the whole of it in its own session.
    event=$(oversize_note "$n")
    n=$(( $(byte_length "$event") + 1 ))
  fi

  # The complete log is bounded as well, for the same reason as the panel's copy:
  # room is made before the write. A log that nobody reads growing for as long as
  # the conversation does is not the whole conversation, it is a leak.
  if (( $(file_size "$events") + n > EVENTS_LOG_MAX)); then
    keep=$EVENTS_LOG_KEEP
    ((keep < EVENTS_LOG_MAX - n)) || keep=$((EVENTS_LOG_MAX - n))
    trim_log "$events" "$keep" || return 0
  fi
  printf '%s\n' "$event" >>"$events"

  if ((n > PANEL_LOG_MAX)); then
    # Bigger than the entire panel budget, so no amount of trimming makes room
    # for it. The panel gets a note in place of the whole log, written atomically
    # so it is never seen empty.
    write_atomic "$panel" <<<"$(panel_standin "$n")"
    file_size "$panel"
    return 0
  fi

  bytes=${bytes:-$(file_size "$panel")}
  if ((bytes + n > PANEL_LOG_MAX)); then
    # Make room first, keeping as much of the tail as still leaves the event
    # room. Trimming here rather than afterwards is what guarantees the newest
    # event is kept: it is written once the file is already small enough.
    keep=$PANEL_LOG_KEEP
    ((keep < PANEL_LOG_MAX - n)) || keep=$((PANEL_LOG_MAX - n))
    trim_log "$panel" "$keep" || return 0
    bytes=$(file_size "$panel")
  fi
  printf '%s\n' "$event" >>"$panel"
  printf '%s' "$((bytes + n))"
}

# `~` and a relative path are typed by humans; the panel and the event log want
# one absolute directory that means the same thing tomorrow.
expand_path() {
  local path="${1:-}"
  [[ -z "$path" ]] && return 1
  case "$path" in
    "~") path="$HOME" ;;
    "~/"*) path="$HOME/${path#\~/}" ;;
  esac
  [[ "$path" != /* ]] && path="$PWD/$path"
  readlink -f "$path" 2>/dev/null || printf '%s' "$path"
}

# The directory the user picked in the panel, if they picked one. A run falls
# back to this before it falls back to the focused window, so the workspace
# survives closing the panel.
pinned_workdir() {
  local dir="$1"
  [[ -f "$dir/meta.json" ]] || return 0
  jq -r 'select(.workdirPinned == true) | .workdir // empty' "$dir/meta.json" 2>/dev/null
}

read_pid() {
  local dir="$1"
  [[ -f "$dir/meta.json" ]] || return 0
  jq -r '.pid // 0' "$dir/meta.json" 2>/dev/null || echo 0
}

# ---------------------------------------------------------------- agents

# opencode gets installed in several ways (mise, a system package, the install
# script), and the shell that runs this plugin does not necessarily carry the
# PATH a terminal has. PATH answers first; the places opencode actually lands
# answer the rest, so "no agents" means "no opencode" and not "odd PATH".
RESOLVED_OPENCODE=""

resolve_opencode() {
  [[ -n "$RESOLVED_OPENCODE" ]] && return 0

  if command -v "$OPENCODE_BIN" >/dev/null 2>&1; then
    RESOLVED_OPENCODE=$(command -v "$OPENCODE_BIN")
    return 0
  fi

  # An explicit path was given: honour it or fail, never go looking elsewhere.
  if [[ "$OPENCODE_BIN" == */* ]]; then
    [[ -x "$OPENCODE_BIN" ]] && RESOLVED_OPENCODE="$OPENCODE_BIN"
    [[ -n "$RESOLVED_OPENCODE" ]]
    return $?
  fi

  local candidate
  for candidate in \
    "$HOME/.local/bin/$OPENCODE_BIN" \
    "$HOME/.opencode/bin/$OPENCODE_BIN" \
    "$HOME/.local/share/mise/shims/$OPENCODE_BIN" \
    "/usr/local/bin/$OPENCODE_BIN" \
    "/usr/bin/$OPENCODE_BIN"; do
    if [[ -x "$candidate" ]]; then
      RESOLVED_OPENCODE="$candidate"
      return 0
    fi
  done

  # mise keeps one directory per installed version; the glob is sorted, so the
  # last match is the newest install.
  local found=()
  for candidate in "$HOME"/.local/share/mise/installs/"$OPENCODE_BIN"/*/"$OPENCODE_BIN"; do
    [[ -x "$candidate" ]] && found+=("$candidate")
  done
  if [[ ${#found[@]} -gt 0 ]]; then
    RESOLVED_OPENCODE="${found[-1]}"
    return 0
  fi

  return 1
}

cmd_agents() {
  if ! resolve_opencode; then
    echo '[]'
    return 0
  fi

  local list
  list=$("$RESOLVED_OPENCODE" agent list 2>/dev/null)
  [[ -n "$list" ]] || { echo '[]'; return 0; }

  local first=1
  printf '['
  while IFS= read -r line; do
    # Agent headings sit in column 0; everything under them is the indented
    # permission block.
    [[ -z "${line//[[:space:]]/}" ]] && continue
    [[ "$line" =~ ^[[:space:]] ]] && continue

    local id mode
    if [[ "$line" =~ ^([^[:space:]]+)[[:space:]]+\((primary|subagent|all)\)$ ]]; then
      id="${BASH_REMATCH[1]}"
      mode="${BASH_REMATCH[2]}"
    else
      id="${line%%[[:space:]]*}"
      mode="all"
    fi
    [[ -z "$id" ]] && continue
    # The permission block below a heading is indented but for its closing
    # bracket, which lands in column 0 like a heading does.
    [[ "$id" =~ ^[][{}(),]+$ ]] && continue

    [[ $first -eq 0 ]] && printf ','
    first=0
    jq -nc --arg id "$id" --arg mode "$mode" '{id: $id, mode: $mode}'
  done <<<"$list"
  printf ']\n'
}

# ---------------------------------------------------------------- doctor

# What the panel would see if it asked right now. The panel has no way to show a
# stack trace, so this is the command that answers "why is the agent list
# empty?" without reading the shell's log.
cmd_doctor() {
  local found="false" path="" version="" agents="0" writable="false"
  if resolve_opencode; then
    found="true"
    path="$RESOLVED_OPENCODE"
    version=$("$RESOLVED_OPENCODE" --version 2>/dev/null | head -1)
    agents=$(cmd_agents | jq 'length' 2>/dev/null || echo 0)
  fi

  if mkdir -p "$STATE_DIR" 2>/dev/null && [[ -w "$STATE_DIR" ]]; then
    writable="true"
  fi

  jq -nc \
    --argjson found "$([[ "$found" == "true" ]] && echo true || echo false)" \
    --arg requested "$OPENCODE_BIN" \
    --arg path "$path" \
    --arg version "$version" \
    --argjson agents "${agents:-0}" \
    --arg stateDir "$STATE_DIR" \
    --argjson writable "$([[ "$writable" == "true" ]] && echo true || echo false)" \
    --argjson onPath "$(command -v "$OPENCODE_BIN" >/dev/null 2>&1 && echo true || echo false)" \
    '{
       opencode: {
         requested: $requested,
         found: $found,
         onPath: $onPath,
         path: $path,
         version: $version
       },
       agents: $agents,
       stateDir: $stateDir,
       stateDirWritable: $writable
     }'
}

# ---------------------------------------------------------------- append

cmd_append() {
  local dir
  dir=$(agent_dir "${1:-}") || return 1
  local line="${2:-}"
  [[ -z "$line" ]] && { log "append needs a JSON event"; return 1; }
  jq -e . >/dev/null 2>&1 <<<"$line" || { log "append needs valid JSON"; return 1; }
  mkdir -p "$dir" || return 1
  # A single small line, appended with >> : the worker appends the same way,
  # so the only thing that matters is that a line never lands in two pieces.
  append_event "$dir" "$line"
}

# ------------------------------------------------------------------- cwd

# The directory a human would expect the agent to work in: where the focused
# window is. Falls back to $HOME when the window is not a process we can read.
cmd_cwd() {
  local pid="" dir=""
  if command -v hyprctl >/dev/null 2>&1; then
    pid=$(hyprctl -j activewindow 2>/dev/null | jq -r '.pid // 0' 2>/dev/null)
  fi
  if [[ "$pid" =~ ^[0-9]+$ ]] && [[ "$pid" != "0" ]] && [[ -e "/proc/$pid/cwd" ]]; then
    dir=$(readlink -f "/proc/$pid/cwd" 2>/dev/null)
  fi
  if [[ -n "$dir" && -d "$dir" ]]; then
    printf '%s\n' "$dir"
  else
    printf '%s\n' "$HOME"
  fi
}

# ---------------------------------------------------------------------- cd
#
# `cd` is the workspace switch: a directory the user picked, kept in meta.json
# so the panel can show it after a reload and the next run can use it without
# being told. --window follows the focused window, --reset forgets the choice.
cmd_cd() {
  local agent="${1:-}" target="${2:-}"
  local dir pinned resolved=""
  dir=$(agent_dir "$agent") || return 1
  [[ -f "$dir/meta.json" ]] || cmd_init "$agent" >/dev/null || return 1

  case "$target" in
    "")
      log "cd needs a directory, --window or --reset"
      return 1
      ;;
    --reset)
      pinned="false"
      ;;
    --window)
      pinned="true"
      resolved=$(cmd_cwd)
      ;;
    *)
      pinned="true"
      resolved=$(expand_path "$target")
      if [[ ! -d "$resolved" ]]; then
        # A file is not a missing directory, and "no such directory" on a path
        # that is visibly right there is the kind of message that sends someone
        # looking for a typo that is not there.
        if [[ -e "$resolved" ]]; then
          log "not a directory: $target"
        else
          log "no such directory: $target"
        fi
        return 1
      fi
      ;;
  esac

  jq -c --argjson pinned "$pinned" --arg workdir "$resolved" \
    '.workdirPinned = $pinned | .workdir = $workdir' \
    "$dir/meta.json" | write_atomic "$dir/meta.json" || return 1
  printf '%s\n' "$resolved"
}

# ---------------------------------------------------------------- complete
#
# Directory completion for the panel's workspace field: `agenttalk complete
# [dir-prefix] [stem]` prints the directories under dir-prefix that start with
# stem, one per line, and nothing at all when there is no match. It is a
# subcommand rather than a QML directory read because the panel never touches a
# file it did not create, and because the same logic belongs in a shell
# completion function where it can be reused.
cmd_complete() {
  local prefix="${1:-}" stem="${2:-}"
  local dir
  # A stem that holds a slash is part of the path, not a name. The panel splits
  # the field at its last slash, so it sends `Code/A` as a prefix and a stem,
  # while a person at a terminal types it as one string; folding the two back
  # together means both spellings complete the same, instead of the second one
  # matching nothing and looking like a directory that is not there.
  if [[ "$stem" == */* ]]; then
    prefix="$prefix$stem"
    # Split back at the last slash, so the new prefix is the directory and the
    # new stem is the name being typed. A trailing slash leaves the stem empty,
    # which is the question "what is inside this directory".
    stem="${prefix##*/}"
    prefix="${prefix%/*}/"
  fi
  # A path that does not start at the root is one the user means from their home
  # directory, which is what the panel sends too, so both agree on where a bare
  # name lives. `expand_path` would resolve it against whatever directory the
  # script happens to be started in, which for a panel is wherever the shell was.
  if [[ "$prefix" != /* && "$prefix" != "~"* ]]; then
    prefix="$HOME/$prefix"
  fi
  # An empty prefix is the empty field, which means "from the top": $HOME, the
  # same place a bare ~ in the field would start from. A trailing slash on the
  # prefix is the question "what is inside this directory", and leaves the stem
  # empty: that is how Tab after a unique match keeps the list useful, instead
  # of emptying itself one keypress after it was right and leaving the field
  # claiming a directory does not exist while standing in it.
  if [[ -z "$prefix" ]]; then
    dir="$HOME"
  else
    dir=$(expand_path "$prefix") || return 0
  fi
  # A prefix that names a file, or names nothing, simply has no completions.
  # `find` walks one level without a shell glob, so a name with a space or a
  # bracket in it still completes instead of erroring out, and it never follows
  # a symlink into somewhere the user did not ask about.
  [[ -d "$dir" ]] || return 0
  # `-iname`, not `-name`: the panel is not a shell, so there is no
  # case-sensitivity muscle memory to lean on, and a case-sensitive match turns
  # `agent` into silence where `AgentTalk` is sitting right there. The silence is
  # what makes it expensive, because the field cannot tell "no match" from "the
  # completion is broken" and the next thing the user does is press Enter and be
  # told the directory does not exist.
  #
  # A leading dot in the stem asks for the hidden ones, which is what a shell
  # does and what makes `.local` reachable by typing it. Without that they are
  # never offered, because one stray dot directory at the front of a list shifts
  # the common prefix of everything behind it.
  if [[ "$stem" == .* ]]; then
    find "$dir/" -mindepth 1 -maxdepth 1 -type d -iname "${stem}*" -printf '%f\n' 2>/dev/null
  else
    find "$dir/" -mindepth 1 -maxdepth 1 -type d -iname "${stem}*" ! -name '.*' -printf '%f\n' 2>/dev/null
  fi | LC_ALL=C sort -f
}

# ------------------------------------------------------------------- init

# The one place a fresh meta.json is written. `init` and `clear` both used to
# spell this object out themselves, and `clear` kept the older spelling, so a
# cleared conversation came back without its workspace keys at all.
write_meta() {
  local dir="${1:-}" agent="${2:-}" workdir="${3:-}" pinned="${4:-false}"
  [[ "$pinned" == "true" ]] || pinned="false"
  jq -nc --arg agent "$agent" --arg workdir "$workdir" --argjson pinned "$pinned" \
    '{agent: $agent, sessionID: "", workdir: $workdir, workdirPinned: $pinned, running: false, pid: 0, exitCode: null}' \
    | write_atomic "$dir/meta.json"
}

# Make sure agents have a session directory with the two files the panel
# watches, so a FileView never has to watch something that does not exist.
cmd_init() {
  local id dir
  for id in "$@"; do
    dir=$(agent_dir "$id") || return 1
    mkdir -p "$dir" || return 1
  [[ -f "$dir/events.jsonl" ]] || : >"$dir/events.jsonl"
  [[ -f "$dir/panel.jsonl" ]] || : >"$dir/panel.jsonl"
  [[ -f "$dir/meta.json" ]] && continue
  write_meta "$dir" "$id"
done
}

# -------------------------------------------------------------- keybinding
#
# The panel is a bar button, and a bar button you have to aim at is a bar button
# you stop using. These two subcommands keep one small managed block in
# ~/.config/hypr/bindings.lua, so installing the binding is one command and
# changing it later is one more. The block is marked the same way the other
# plugins on this machine mark theirs, so it is obvious what is ours and easy to
# remove by hand.

BINDINGS_FILE="$HYPR_DIR/bindings.lua"
BIND_START="-- >>> agenttalk (managed by bin/agenttalk)"
BIND_END="-- <<< agenttalk"
BIND_DEFAULT_COMBO="SUPER + A"
BIND_DEFAULT_KEY="A"

# Omarchy's o.bind takes the whole combo as one string, the way its own
# bindings.lua does, so the only work here is getting the words the user typed
# into that shape: "SUPER CTRL A", "SUPER + A" and "SUPER+A" are one binding.
# A lone modifier is worth accepting because it is the common "I only care about
# the modifier" case, and A is the key this plugin has always used.
normalize_combo() {
  local raw="" word
  for word in "$@"; do
    raw+="${raw:+ }${word//+/ }"
  done
  # shellcheck disable=SC2086
  set -- $raw
  if [[ $# -eq 0 ]]; then
    BIND_COMBO="$BIND_DEFAULT_COMBO"
    return 0
  fi
  if [[ $# -eq 1 ]]; then
    set -- "${1^^}" "$BIND_DEFAULT_KEY"
  fi
  local out="" sep="" word
  for word in "$@"; do
    out+="$sep${word^^}"
    sep=" + "
  done
  BIND_COMBO="$out"
}

bind_block() {
  cat <<LUA
$BIND_START
-- Opens the AgentTalk panel. Remove this block, or run: agenttalk unbind
hl.unbind("$BIND_COMBO")
o.bind("$BIND_COMBO", "AgentTalk", "omarchy-shell shell toggle $PLUGIN_ID")
$BIND_END
LUA
}

cmd_bind() {
  local print_only="false"
  if [[ "${1:-}" == "--print" ]]; then
    shift
    print_only="true"
  fi

  BIND_COMBO=""
  normalize_combo "$@"
  local combo="$BIND_COMBO"

  if [[ "$print_only" == "true" ]]; then
    bind_block
    return 0
  fi

  if [[ ! -f "$BINDINGS_FILE" ]]; then
    log "no $BINDINGS_FILE; add this by hand:"
    bind_block >&2
    return 1
  fi

  local tmp
  tmp=$(mktemp) || return 1
  if grep -qF -- "$BIND_START" "$BINDINGS_FILE"; then
    # Replace the block we own, leave everything else exactly as it was.
    awk -v start="$BIND_START" -v end="$BIND_END" '
      $0 == start { skip = 1 }
      skip != 1 { print }
      $0 == end { skip = 0 }
    ' "$BINDINGS_FILE" >"$tmp"
  else
    cat "$BINDINGS_FILE" >"$tmp"
  fi

  # One trailing newline, then our block: end of file is the easiest place for a
  # reader to find it.
  if [[ -s "$tmp" ]]; then printf '\n' >>"$tmp"; fi
  bind_block >>"$tmp"
  cat "$tmp" >"$BINDINGS_FILE"
  rm -f "$tmp"

  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1
  fi
  echo "bound $combo to AgentTalk (see $BINDINGS_FILE)"
}

cmd_unbind() {
  if [[ ! -f "$BINDINGS_FILE" ]]; then
    echo "nothing to remove"
    return 0
  fi
  if ! grep -qF -- "$BIND_START" "$BINDINGS_FILE"; then
    echo "no agenttalk keybinding found"
    return 0
  fi

  local tmp combo
  tmp=$(mktemp) || return 1
  # Read the combo out of our own block, not the first hl.unbind in the file:
  # the point is to tell the user which key just went free.
  combo=$(awk -v start="$BIND_START" -v end="$BIND_END" '
    $0 == start { inblock = 1; next }
    $0 == end { inblock = 0 }
    inblock && match($0, /hl\.unbind\("[^"]*"\)/) {
      print substr($0, RSTART + 11, RLENGTH - 13)
    }
  ' "$BINDINGS_FILE" | head -1)
  awk -v start="$BIND_START" -v end="$BIND_END" '
    $0 == start { skip = 1 }
    skip != 1 { print }
    $0 == end { skip = 0 }
  ' "$BINDINGS_FILE" >"$tmp"
  # Squeeze the blank line our block left behind, so repeated bind/unbind
  # cycles do not slowly pad the end of somebody's config.
  sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$tmp"
  cat "$tmp" >"$BINDINGS_FILE"
  rm -f "$tmp"

  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1
  fi
  if [[ -n "$combo" ]]; then
    echo "removed the agenttalk binding on $combo"
  else
    echo "removed the agenttalk binding"
  fi
}

# ------------------------------------------------------------------ clear

cmd_clear() {
  local dir
  dir=$(agent_dir "${1:-}") || return 1
  local pid
  pid=$(read_pid "$dir")
  if [[ "$pid" != "0" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null
    sleep 0.3
  fi
  # The workspace is not part of the conversation, so it survives a clear: a
  # user who pinned a directory did that on purpose, and "forget the
  # conversation" is not "forget where you were working". The pin has its own
  # reset (`cd --reset`, the panel's reset button).
  local workdir="" pinned=false
  if [[ -f "$dir/meta.json" ]]; then
    workdir=$(jq -r '.workdir // ""' "$dir/meta.json" 2>/dev/null)
    pinned=$(jq -r '.workdirPinned // false' "$dir/meta.json" 2>/dev/null)
  fi
  rm -f "$dir/events.jsonl" "$dir/panel.jsonl" "$dir/meta.json" "$dir/stderr.log"
  # A worker killed between mktemp and mv leaves its half-written meta.json
  # behind under a name nothing reads. Sweep them so the directory only ever
  # holds what the panel looks at.
  rm -f "$dir"/meta.json.??????
  mkdir -p "$dir"
  : >"$dir/events.jsonl"
  : >"$dir/panel.jsonl"
  write_meta "$dir" "${1:-}" "$workdir" "$pinned"
}

# ------------------------------------------------------------------- stop

cmd_stop() {
  local dir
  dir=$(agent_dir "${1:-}") || return 1
  local agent="${1:-}"
  local pid
  pid=$(read_pid "$dir")
  if [[ "$pid" == "0" ]] || ! kill -0 "$pid" 2>/dev/null; then
    log "no run in progress"
    return 0
  fi

  # Prefer the opencode process itself: killing the worker's whole group would
  # take the worker down before it can record how the run ended.
  local runpid=""
  [[ -f "$dir/run.pid" ]] && runpid=$(<"$dir/run.pid")
  if [[ "$runpid" =~ ^[0-9]+$ ]] && kill -0 "$runpid" 2>/dev/null; then
    kill -TERM "$runpid" 2>/dev/null
    return 0
  fi

  # The worker is a session leader, so its pid is also its process group id.
  # This path means the run is already unravelling; kill it and close the log
  # ourselves, because nothing is left that will.
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
  sleep 0.3
  mkdir "$dir/.finalized" 2>/dev/null
  append_event "$dir" "$(jq -nc '{t: "error", text: "the run was stopped"}')"
  append_event "$dir" "$(jq -nc '{t: "done", code: 143}')"
  jq -c '.running = false | .pid = 0 | .exitCode = 143' "$dir/meta.json" \
    | write_atomic "$dir/meta.json"
  rm -f "$dir/run.pid"
  log "stopped $agent"
}

# -------------------------------------------------------------------- run

# Turn opencode's raw JSON event stream into the handful of shapes the panel
# knows how to draw. Anything we do not recognize is dropped rather than
# forwarded, so the panel never has to know about steps or messages.
normalize_stream() {
  local -a filter=(
    'if .type == "text" and ((.part.text // "") | length) > 0
       then {t: "text", text: .part.text}
     elif .type == "tool_use"
       then {t: "tool", tool: (.part.tool // "tool"),
             status: (.part.state.status // "running"),
             title: (.part.state.title // "")}
     elif .type == "error" or .part.type == "error"
       then {t: "error", text: ((.part.error // .error // "run failed") | tostring)}
     elif ((.sessionID // "") | length) > 0
       then {t: "session", id: .sessionID}
     else empty end'
  )
  local line
  while read_bounded; do
    if ((reply_dropped)); then
      reply_dropped=0
      oversize_note
    fi
    [[ -z "$REPLY" ]] && continue
    jq -c "${filter[@]}" <<<"$REPLY" 2>/dev/null || true
  done
  # An event that was too large and also the last thing in the stream is
  # reported here: the loop above ends before it ever looked at the flag.
  ((reply_dropped)) && { reply_dropped=0; oversize_note; }
}

# The detached half of `run`. Writes the session id, the running flag and the
# pids to meta.json, streams normalized events into the log, and always finishes
# through `finalize` so the panel can never be left showing a run that is not
# running.
worker() {
  local agent="$1" prompt_file="$2" workdir="$3" auto="$4" fresh="$5"
  local dir events meta panel panel_bytes
  dir=$(agent_dir "$agent") || return 1
  events="$dir/events.jsonl"
  meta="$dir/meta.json"
  panel="$dir/panel.jsonl"
  mkdir -p "$dir"
  touch "$events"
  # The count starts from the file, so a run that picks up an already long
  # conversation trims on its first event instead of waiting for its own.
  panel_bytes=$(file_size "$panel")

  # The worker is its own process, so it resolves opencode for itself: the
  # session it was spawned from may have been started from a different PATH.
  if ! resolve_opencode; then
    append_event "$dir" "$(jq -nc --arg t "$OPENCODE_BIN not found" '{t: "error", text: $t}')"
    append_event "$dir" "$(jq -nc '{t: "done", code: 127}')"
    jq -nc --arg agent "$agent" \
      '{agent: $agent, sessionID: "", workdir: "", workdirPinned: false, running: false, pid: 0, exitCode: 127}' \
      | write_atomic "$meta"
    return 127
  fi

  # `finalize` may run from a signal handler as well as from the happy path, so
  # it takes a lock rather than trusting to be called once. `run` clears the
  # lock before it spawns the next worker.
  local lock="$dir/.finalized"

  finalize() {
    local code="$1"
    mkdir "$lock" 2>/dev/null || return 0
    if [[ "$code" == "124" ]]; then
      append_event "$dir" "$(jq -nc --arg t "the run exceeded ${RUN_TIMEOUT}s and was stopped" \
        '{t: "error", text: $t}')"
    fi
    append_event "$dir" "$(jq -nc --argjson code "$code" '{t: "done", code: $code}')"
    jq -c --argjson code "$code" --arg s "$session_id" \
      '.running = false | .pid = 0 | .exitCode = $code | .sessionID = $s' \
      <<<"$current" | write_atomic "$meta"
    rm -f "$dir/run.pid"
  }
  trap 'finalize 143' TERM INT HUP

  local session_id=""
  if [[ "$fresh" == "false" && -f "$meta" ]]; then
    session_id=$(jq -r '.sessionID // ""' "$meta" 2>/dev/null)
  fi

  local -a args=(run --format json)
  [[ "$agent" != "" ]] && args+=(--agent "$agent")
  [[ -n "$session_id" ]] && args+=(--session "$session_id")
  [[ "$auto" == "true" ]] && args+=(--auto)

  local prompt
  prompt=$(cat "$prompt_file" 2>/dev/null)
  rm -f "$prompt_file"

  # Your own words go into the log before the agent answers, so reopening the
  # panel later shows the question next to the answer. opencode's stream never
  # repeats the prompt. The workdir travels with it: a transcript read days
  # later has to say which tree each question was asked in, because the panel's
  # header only ever shows the current one.
  #
  # `env`, not `--arg`: an environment is readable only by its owner, while
  # argv is world readable, and this is the user's own words.
  append_event "$dir" "$(AGENTTALK_TEXT="$prompt" jq -nc --arg workdir "$workdir" \
    '{t: "user", text: env.AGENTTALK_TEXT, workdir: $workdir}')"

  # The workdir the user picked in the panel outlives this run, so it is read
  # before meta.json is rebuilt rather than after.
  local pinned="false"
  [[ -f "$meta" ]] && pinned=$(jq -r '.workdirPinned // false' "$meta" 2>/dev/null || echo false)

  local current=""
  current=$(jq -c --arg agent "$agent" --arg workdir "$workdir" --arg session "$session_id" \
    --argjson pinned "$pinned" \
    '{
       agent: $agent,
       sessionID: $session,
       workdir: $workdir,
       workdirPinned: $pinned,
       running: true,
       pid: 0,
       startedAt: now,
       exitCode: null
     }' 2>/dev/null <<<"{}") || current='{}'

  # $$ is this worker's pid and, because setsid made it a session leader, also
  # its process group id: a group kill gets the whole run, signal handling
  # included.
  current=$(jq -c --argjson pid "$$" '.pid = $pid' <<<"$current")
  write_atomic "$meta" <<<"$current"

  local status=0
  # The subshell's own pid survives `exec`, so run.pid stays a valid handle on
  # `timeout` for as long as the run lasts. `stop` signals that instead of the
  # group: killing the group would take this worker down with it, and the run
  # would end with a log that never says so.
  (
    cd "$workdir" || exit 1
    printf '%s\n' "$BASHPID" >"$dir/run.pid"
    # opencode reads the message from stdin when it gets no positional, and a
    # pipe is not in any process list. `< <(...)` keeps the `exec` that makes
    # the subshell's pid a valid handle on this run.
    exec timeout --kill-after=10 "$RUN_TIMEOUT" "$RESOLVED_OPENCODE" "${args[@]}" \
      < <(printf '%s' "$prompt")
  ) 2>"$dir/stderr.log" \
    | normalize_stream \
    | while read_bounded; do
        event=$REPLY
        # `append_event` and not a second copy of the arithmetic: the two copies
        # disagreed about when the cap was enforced, and the copy in here was
        # the one that let an oversized event through.
        panel_bytes=$(append_event "$dir" "$event" "$panel_bytes")
        # Every raw event carries the session id. The first one is all the next
        # turn needs to continue this conversation instead of starting over.
        if [[ -z "$session_id" && "$event" == '{"t":"session"'* ]]; then
          session_id=$(jq -r '.id // ""' <<<"$event" 2>/dev/null)
          jq -c --arg s "$session_id" '.sessionID = $s' <<<"$current" | write_atomic "$meta"
        fi
      done
  status=${PIPESTATUS[0]}

  # The loop above ran in a subshell, so pick the session id back up from disk.
  session_id=$(jq -r '.sessionID // ""' "$meta" 2>/dev/null)

  finalize "$status"
}

cmd_run() {
  local agent="${1:-}"
  # Only the agent is positional now; everything after it is an option, and the
  # prompt is not in argv at all.
  [[ $# -gt 0 ]] && shift
  local auto="false" fresh="false" workdir=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --auto) auto="true" ;;
      --new) fresh="true" ;;
      --dir) workdir="${2:-}"; shift ;;
      --dir=*) workdir="${1#--dir=}" ;;
      *) log "unknown option: $1" ;;
    esac
    shift
  done

  [[ -n "$agent" ]] || { log "run needs an agent id"; return 1; }

  # The prompt arrives on stdin, not as an argument. A task or a pasted stack
  # trace is the most private thing this plugin ever handles, and argv is world
  # readable: anyone on the machine could read it out of `ps` for as long as the
  # run lasted. stdin is a pipe, and a pipe is nobody else's business.
  local prompt
  prompt=$(cat)

  [[ -n "${prompt//[[:space:]]/}" ]] || { log "run needs a prompt on stdin"; return 1; }

  if ! resolve_opencode; then
    log "$OPENCODE_BIN not found; install opencode or set AGENTTALK_OPENCODE_BIN"
    return 127
  fi

  # No --dir means: the directory the user picked for this agent, then the
  # directory of the window they are looking at.
  if [[ -z "$workdir" ]]; then
    local dir_probe
    dir_probe=$(agent_dir "$agent") || return 1
    workdir=$(pinned_workdir "$dir_probe")
  fi
  [[ -d "$workdir" ]] || workdir=$(cmd_cwd)
  [[ -d "$workdir" ]] || workdir="$HOME"

  local dir
  dir=$(agent_dir "$agent") || return 1
  mkdir -p "$dir"

  local pid
  pid=$(read_pid "$dir")
  if [[ "$pid" != "0" ]] && kill -0 "$pid" 2>/dev/null; then
    log "$agent is already running (pid $pid)"
    return 1
  fi

  # The lock belongs to the previous run; the new worker takes it.
  rm -rf "$dir/.finalized"
  rm -f "$dir/run.pid"

  # The prompt goes through a file rather than argv: a pasted stack trace can be
  # long, and this keeps it out of every `ps` on the machine while the run
  # lasts. It arrives here on stdin and leaves on stdin; the file is only how
  # the detached worker gets it from this process to the next. The worker
  # deletes it when it is done.
  local prompt_file
  prompt_file=$(mktemp "$dir/prompt.XXXXXX") || return 1
  printf '%s' "$prompt" >"$prompt_file"

  # A worker that dies before opencode starts has no transcript to explain it,
  # so its own stderr gets a file of its own. Empty means the run went normal.
  : >"$dir/worker.log"

  local self="$0"
  setsid nohup "$self" --worker "$agent" "$prompt_file" "$workdir" "$auto" "$fresh" \
    >/dev/null 2>>"$dir/worker.log" </dev/null &
  disown 2>/dev/null || true
}

# ------------------------------------------------------------------- main

main() {
  case "${1:-}" in
    agents) shift; cmd_agents "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    init) shift; cmd_init "$@" ;;
    append) shift; cmd_append "$@" ;;
    run) shift; cmd_run "$@" ;;
    clear) shift; cmd_clear "${1:-}" ;;
    stop) shift; cmd_stop "${1:-}" ;;
    cwd) shift; cmd_cwd "$@" ;;
    cd) shift; cmd_cd "$@" ;;
    complete) shift; cmd_complete "$@" ;;
    state-dir) printf '%s\n' "$STATE_DIR" ;;
    bind) shift; cmd_bind "$@" ;;
    unbind) shift; cmd_unbind "$@" ;;
    --worker)
      shift
      worker "$@"
      ;;
    *)
      # The header comment is the manual: print every line of it, whatever its
      # length, rather than a line range that goes stale on the next edit.
      awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"
      exit 1
      ;;
  esac
}

# Sourcing this file reaches the helpers without running a command. The tests
# need `write_atomic` on its own, because what it guarantees is what a reader
# sees at the instant of the write, and that is not observable from outside the
# script: a CLI this fast finishes before a caller can look.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
